{
  "name": "ocrcraft",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "check:ui": "node scripts/check-ui-regressions.mjs",
    "db:build-initial": "node scripts/build-initial-schema.mjs",
    "data:audit": "node scripts/audit-source-catalogs.mjs",
    "data:match": "node scripts/match-source-catalogs.mjs",
    "data:ocr-relevance": "node scripts/audit-ocr-relevance.mjs",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "exercise:image": "node --conditions=react-server --import=tsx scripts/generate-exercise-image.ts",
    "exercise:images:seed": "node --conditions=react-server --import=tsx scripts/generate-seed-exercise-images.ts",
    "exercise:images:import-named": "node scripts/import-named-exercise-images.mjs",
    "exercise:import:hasaneyldrm": "node --conditions=react-server --import=tsx scripts/import-hasaneyldrm-exercises.ts",
    "exercise:translate:de": "node --conditions=react-server --import=tsx scripts/translate-hasaneyldrm-german.ts",
    "exercise:import:exercisedb": "node --conditions=react-server --import=tsx scripts/import-exercisedb-exercises.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@duckdb/node-api": "1.5.5-r.5",
    "@next/env": "^16.3.5",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5",
    "@github/copilot-sdk": "1.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "svg-path-properties": "^2.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
